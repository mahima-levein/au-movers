---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import WhoWeAre from "../components/sections/WhoWeAre.astro";
import Services from "../components/sections/Services.astro";
import ImageFillText from "../components/ui/ImageFillText.astro";
import ProjectsPortfolio from "../components/sections/ProjectsPortfolio.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import FaqSection from "../components/sections/FaqSection.astro";
import PricingPlans from "../components/sections/PricingPlans.astro";
import RequestQuote from "../components/sections/RequestQuote.astro";
import movingImage from "../assets/who-we-are.jpg";
---

<BaseLayout>
  <main id="landing-page">
    <Hero />
    <WhoWeAre />
    <Services />
    <ImageFillText image={movingImage} />
    <ProjectsPortfolio />
    <ProcessSteps />
    <FaqSection />
    <!-- <PricingPlans /> -->
    <RequestQuote />
  </main>
</BaseLayout>
