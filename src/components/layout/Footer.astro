---
import { ArrowRight, ArrowUp, MessageCircle, Phone, Send } from "@lucide/astro";
import { Image } from "astro:assets";
import logo from "../../../public/anp-logo.png";
const homeLink = (href: string) =>
  Astro.url.pathname === "/" ? href : `/${href}`;
const companyLinks = [
  ["About Us", "#who-we-are"],
  ["Our Services", "#services"],
  ["Steps", "#process-steps"],
  ["Reviews", "#customer-reviews"],
  ["Contact Us", "#request-quote"],
];
const services = [
  "Residential Moving",
  "Commercial Moving",
  "Local Moving",
  "Long Distance Moving",
  "Packing & Unpacking",
];
const footerLink =
  "inline-flex min-h-11 items-center text-sm leading-6 text-white/80 transition-colors duration-200 hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-brand-gold focus-visible:outline-offset-4";
const whatsappUrl = `https://wa.me/61451004235?text=${encodeURIComponent("Hi ANP Movers! I'm planning a move and would like a quote. Could you help me with availability and pricing?")}`;
const contactItems = [
  {
    label: "Send your enquiry",
    text: "Get a moving quote",
    href: "#request-quote",
    icon: Send,
  },
  {
    label: "Message our team",
    text: "WhatsApp",
    href: whatsappUrl,
    icon: MessageCircle,
  },
  {
    label: "Talk to us",
    text: "0451 004 235",
    href: "tel:+61451004235",
    icon: Phone,
  },
];
---

<footer id="site-footer" class="pb-3 text-white">
  <div class="relative isolate mx-[clamp(12px,1vw,18px)] overflow-hidden rounded-[28px] bg-[#080c1b] px-5 pt-12 pb-40 sm:px-8 sm:pt-16 sm:pb-44 lg:px-12 lg:pt-24 lg:pb-48">
    <div
      class="pointer-events-none absolute inset-0 -z-1 bg-[radial-gradient(ellipse_at_0%_0%,var(--color-brand-ink)_0%,transparent_58%),radial-gradient(ellipse_at_100%_90%,var(--color-brand-gold)_0%,transparent_48%)]"
      aria-hidden="true"
    ></div>
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.95fr_2.2fr] lg:gap-12 xl:gap-16">
      <div class="">
        <a
          href="/"
          aria-label="ANP Movers home"
          class="inline-flex rounded-lg focus-visible:outline-2 focus-visible:outline-brand-gold focus-visible:outline-offset-4"
        >
          <Image
            src={logo}
            widths={[128, 256]}
            sizes="112px"
            format="webp"
            alt="ANP Movers"
            class="h-auto w-28 object-contain"
            loading="lazy"
          />
        </a>
        <p class="mt-5 max-w-sm text-sm leading-7 text-white/80">
          Explore our moving services and get in touch with our team.
        </p>
        <div class="mt-6 space-y-3 border-t border-white/15 pt-5">
          <a
            href={homeLink("#request-quote")}
            class="flex min-h-11 items-center justify-between gap-3 text-sm font-semibold transition-colors hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-brand-gold focus-visible:outline-offset-4"
          >
            Plan your move <ArrowRight size={18} aria-hidden="true" />
          </a>
          <!-- <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-11 items-center gap-3 text-sm text-white/80 transition-colors hover:text-brand-gold focus-visible:outline-2 focus-visible:outline-brand-gold focus-visible:outline-offset-4"
          >
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-white text-brand-ink">
              <MessageCircle size={18} aria-hidden="true" />
            </span>
            Chat on WhatsApp <span class="sr-only">(opens in a new tab)</span>
          </a> -->
        </div>
      </div>
      <div class="min-w-0">
        <div class="grid grid-cols-[0.85fr_1.15fr] gap-x-5 gap-y-10 sm:gap-x-8 md:grid-cols-[0.7fr_0.95fr_1.5fr] lg:gap-x-7 xl:gap-x-10">
          <nav aria-labelledby="footer-company-heading" class="min-w-0">
            <h2
              id="footer-company-heading"
              class="mb-5 text-lg font-semibold tracking-tight"
            >
              Company
            </h2>
            <ul class="space-y-1">
              {companyLinks.map(([label, href]) => (
                <li>
                  <a class={footerLink} href={homeLink(href)}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <nav aria-labelledby="footer-services-heading" class="min-w-0">
            <h2
              id="footer-services-heading"
              class="mb-5 text-lg font-semibold tracking-tight"
            >
              Our Services
            </h2>
            <ul class="space-y-1">
              {services.map((label) => (
                <li>
                  <a class={footerLink} href={homeLink("#services")}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="col-span-2 min-w-0 md:col-span-1">
            <h2 class="mb-5 text-lg font-semibold tracking-tight">
              Newsletter
            </h2>
            <p class="max-w-sm text-sm leading-7 text-white/80">
              Updates from ANP MOVERS, straight to your inbox.
            </p>
            <form
              id="newsletter-form"
              class="mt-6 flex min-h-12 items-center gap-2 rounded-lg bg-white p-1.5 focus-within:outline-2 focus-within:outline-brand-gold focus-within:outline-offset-4"
            >
              <label class="sr-only" for="newsletter-email">
                Your email address
              </label>
              <input
                id="newsletter-email"
                class="w-full min-w-0 bg-transparent px-3 py-2 text-sm text-brand-ink outline-none placeholder:text-brand-ink/60"
                type="email"
                name="email"
                autocomplete="email"
                placeholder="Your email address"
                required
              />
              <button
                class="grid size-11 shrink-0 cursor-pointer place-items-center rounded-full bg-brand-gold text-brand-ink transition-colors hover:bg-brand-ink hover:text-white focus-visible:outline-2 focus-visible:outline-brand-ink focus-visible:outline-offset-2"
                type="submit"
                aria-label="Subscribe to the newsletter"
              >
                <Send size={18} aria-hidden="true" />
              </button>
            </form>
            <p
              class="newsletter-status mt-3 text-xs leading-5 text-white/80 empty:hidden"
              role="status"
              aria-live="polite"
            ></p>
            <p class="mt-3 text-xs leading-5 text-white/60">
              Newsletter subscriptions are not available yet.
            </p>
            <nav
              aria-label="Legal"
              class="mt-3 flex items-center gap-4 text-xs leading-5"
            >
              <a
                href="/terms-and-conditions"
                class="rounded-sm text-white/80 underline-offset-4 transition-colors hover:text-brand-gold hover:underline focus-visible:outline-2 focus-visible:outline-brand-gold focus-visible:outline-offset-4"
              >
                Terms &amp; Conditions
              </a>
              <a
                href="/privacy-policy"
                class="rounded-sm text-white/80 underline-offset-4 transition-colors hover:text-brand-gold hover:underline focus-visible:outline-2 focus-visible:outline-brand-gold focus-visible:outline-offset-4"
              >
                Privacy Policy
              </a>
            </nav>
          </div>
        </div>
        <div class="mt-10 grid gap-6 border-t border-white/10 pt-7 sm:grid-cols-3 lg:mt-12">
          {contactItems.map(({ label, text, href, icon: Icon }) => (
            <a
              href={href.startsWith("#") ? homeLink(href) : href}
              target={href === whatsappUrl ? "_blank" : undefined}
              rel={href === whatsappUrl ? "noopener noreferrer" : undefined}
              class="group flex min-w-0 items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-brand-gold focus-visible:outline-offset-4"
            >
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-gold text-brand-ink transition-transform group-hover:-translate-y-0.5 motion-reduce:transform-none">
                <Icon size={20} aria-hidden="true" />
              </span>
              <span class="min-w-0">
                <span class="block text-xs text-white/65">{label}</span>
                <span class="mt-1 block text-sm font-semibold">
                  {text}
                  {href === whatsappUrl && (
                    <span class="sr-only"> (opens in a new tab)</span>
                  )}
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
    <span
      class="pointer-events-none absolute bottom-[-75px] left-1/2 -translate-x-1/2 whitespace-nowrap text-[clamp(120px,18vw,250px)] leading-none font-extrabold tracking-[-0.08em] text-[#363636] max-[600px]:bottom-[72px] max-[600px]:text-[20vw]"
      aria-hidden="true"
    >
      ANP MOVERS
    </span>
    <p class="absolute inset-x-6 bottom-0 z-1 mx-auto max-w-[600px] rounded-t-[24px] bg-[#faf6f2] px-5 py-5 text-center text-xs leading-6 text-brand-ink sm:inset-x-12 sm:text-sm">
      © 2026 ANP MOVERS. All Rights Reserved.
    </p>
    <button
      class="back-to-top absolute left-4 bottom-20 z-2 grid size-11 cursor-pointer place-items-center rounded-full bg-brand-gold text-brand-ink transition-transform hover:-translate-y-1 focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-4 motion-reduce:transform-none sm:bottom-5"
      type="button"
      aria-label="Back to top"
    >
      <ArrowUp size={18} strokeWidth={1.6} aria-hidden="true" />
    </button>
  </div>
</footer>

<script>
  document
    .querySelector<HTMLFormElement>("#newsletter-form")
    ?.addEventListener("submit", (event) => {
      event.preventDefault();
      const status = document.querySelector<HTMLElement>(
        "#site-footer .newsletter-status",
      );
      if (status) status.textContent = "Subscriptions are not available yet.";
    });
  document
    .querySelector<HTMLButtonElement>("#site-footer .back-to-top")
    ?.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "auto"
          : "smooth",
      });
    });
</script>
