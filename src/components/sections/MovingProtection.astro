---
import { Image } from "astro:assets";
import { FileCheck2, PackageCheck, ShieldCheck, Truck } from "@lucide/astro";
import personImage from "../../assets/mover.webp";
import { protectionFeatures } from "../../data/moving-protection";

const icons = {
  "shield-check": ShieldCheck,
  truck: Truck,
  "package-check": PackageCheck,
  "file-check": FileCheck2,
};
const desktopPositions = [
  "lg:col-start-1 lg:row-start-1",
  "lg:col-start-3 lg:row-start-1 lg:items-end lg:text-right",
  "lg:col-start-1 lg:row-start-2",
  "lg:col-start-3 lg:row-start-2 lg:items-end lg:text-right",
];
---

<section
  id="moving-protection"
  class="overflow-hidden bg-white pt-20 md:pt-24 lg:pt-28"
  aria-labelledby="moving-protection-heading"
>
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl text-center">
      <h2
        id="moving-protection-heading"
        class="mt-4 text-[clamp(2.25rem,4vw,3.5rem)] leading-[1.08] font-semibold tracking-tight text-brand-ink"
      >
        <span class="block">Move With Confidence,</span>
        <span class="block text-brand-gold">Know Your Cover</span>
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-sm leading-7 text-neutral-600 sm:text-base">
        A smooth move is not only about getting from A to B. It is also about
        understanding how your belongings are handled and what protection may
        apply while they are in transit.
      </p>
    </div>

    <div class="mt-12 grid gap-x-10 gap-y-10 md:grid-cols-2 md:gap-y-12 lg:mt-16 lg:grid-cols-[1fr_1.15fr_1fr] lg:gap-x-5 lg:gap-y-12 xl:gap-x-8">
      {protectionFeatures.map((feature, index) => {
        const Icon = icons[feature.icon];
        return (
          <article
            class:list={[
              "group flex min-w-0 flex-col lg:py-2",
              desktopPositions[index],
            ]}
            aria-labelledby={`protection-${feature.id}`}
          >
            <span class="relative grid size-14 shrink-0 place-items-center rounded-xl bg-[#f6f1ec] text-brand-ink transition-[transform,background-color] duration-300 after:absolute after:-bottom-1 after:left-1/2 after:size-3 after:-translate-x-1/2 after:rotate-45 after:bg-inherit group-hover:-translate-y-1 group-hover:bg-brand-gold/15 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0">
              <Icon size={28} strokeWidth={1.5} aria-hidden="true" />
            </span>
            <h3
              id={`protection-${feature.id}`}
              class="mt-7 text-xl leading-snug font-semibold tracking-tight text-brand-ink"
            >
              {feature.title}
            </h3>
            <p class="mt-3 max-w-sm text-sm leading-7 text-neutral-600">
              {feature.description}
            </p>
          </article>
        );
      })}
      <div class="hidden items-end justify-center self-stretch lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:flex">
        <Image
          src={personImage}
          alt=""
          widths={[400, 600, 800]}
          sizes="(min-width: 1280px) 420px, 36vw"
          format="webp"
          loading="lazy"
          class="max-h-[520px] w-full object-contain object-bottom [mask-image:linear-gradient(to_bottom,black_0%,black_75%,transparent_100%)]"
        />
      </div>
    </div>
  </div>
</section>
