---
import { Image } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import { projects } from "../../data/projects";
---

<section
  id="projects-portfolio"
  class="mx-[clamp(12px,1vw,18px)] mb-5 overflow-hidden rounded-[32px] bg-[#f8f3ef]"
  aria-labelledby="projects-portfolio-heading"
>
  <div
    id="projects"
    class="mx-auto grid max-w-7xl items-end gap-6 px-5 py-14 sm:px-6 md:py-18 lg:grid-cols-[auto_minmax(0,1fr)_minmax(200px,270px)] lg:gap-10 lg:px-8 lg:py-20"
  >
    <h2
      id="projects-portfolio-heading"
      class="text-[clamp(2.25rem,3.6vw,3.75rem)] leading-[1.12] font-semibold tracking-tight text-[#173b3b]"
    >
      <span class="block">Our Most Recent Moving</span>
      <span class="block text-[#efbd48]">Projects Portfolio</span>
    </h2>
    <p class="w-full text-sm leading-6 text-[#858181] lg:mb-1">
      It is a long established fact that a reader will be distracted by the
      readable content of a page when looking at its layout.
    </p>
  </div>

  <div
    class="relative isolate min-h-[500px] overflow-hidden bg-[#25211e] lg:min-h-[550px] xl:min-h-[600px]"
    data-projects-row
    aria-label="Recent moving projects"
  >
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      {projects.map((project, index) => (
        <Image
          src={project.image}
          alt=""
          widths={[800, 1200, 1800, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority={index === 0 ? "high" : "auto"}
          class:list={[
            "absolute inset-0 size-full object-cover object-center",
            index === 0 ? "opacity-100" : "opacity-0",
          ]}
          data-project-background
        />
      ))}
    </div>
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/90 via-black/35 to-black/5"
      aria-hidden="true"
    ></div>

    <div
      class="relative z-10 flex min-h-[500px] snap-x snap-mandatory overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:grid lg:min-h-[550px] lg:grid-cols-4 lg:overflow-visible xl:min-h-[600px]"
      data-projects-track
      role="group"
      aria-label="Select a project to see its details"
    >
      {projects.map((project, index) => (
        <article
          class="relative flex min-h-[500px] w-[86vw] shrink-0 snap-start items-end border-r border-white/20 sm:w-[65vw] lg:min-h-[550px] lg:w-auto lg:min-w-0 xl:min-h-[600px]"
          data-project-card
          data-project-index={index}
          data-active={index === 0 ? "true" : "false"}
          aria-labelledby={`project-title-${index}`}
        >
          <div
            class:list={[
              "w-full border-t px-5 py-7 text-white backdrop-blur-sm sm:px-7 lg:px-6 xl:px-9",
              index === 0
                ? "border-white/10 bg-black/55"
                : "border-transparent bg-transparent",
            ]}
            data-project-panel
          >
            <div class="mb-5 flex flex-wrap gap-1.5">
              {project.tags.map((tag) => (
                <span class="rounded-full bg-white/25 px-2.5 py-1 text-xs leading-none text-white">
                  {tag}
                </span>
              ))}
            </div>
            <h3
              id={`project-title-${index}`}
              class="text-lg leading-snug font-semibold tracking-tight xl:text-xl"
            >
              <button
                type="button"
                class="cursor-pointer text-left outline-offset-4 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-[#efbd48]"
                aria-controls={`project-details-${index}`}
                aria-expanded={index === 0 ? "true" : "false"}
                aria-label={`Show ${project.title} details`}
                data-project-trigger
              >
                {project.title}
              </button>
            </h3>
            <div
              id={`project-details-${index}`}
              class:list={[
                "overflow-hidden",
                index === 0 ? "h-auto opacity-100" : "h-0 opacity-0",
              ]}
              data-project-details
              inert={index !== 0}
            >
              <p class="mt-6 max-w-xs text-sm leading-6 text-white/75">
                {project.description}
              </p>
              {project.href ? (
                <a
                  href={project.href}
                  class="group/link mt-6 inline-flex items-center gap-2 border-b border-white/65 pb-0.5 text-sm font-semibold outline-offset-4 transition-colors hover:text-[#efbd48] focus-visible:outline-2 focus-visible:outline-[#efbd48]"
                >
                  View Project
                  <ArrowRight
                    size={16}
                    class="transition-transform group-hover/link:translate-x-1"
                    aria-hidden="true"
                  />
                </a>
              ) : (
                <span
                  class="mt-6 inline-flex items-center gap-2 border-b border-white/45 pb-0.5 text-sm font-semibold text-white/80"
                  title="Project page coming soon"
                >
                  View Project
                  <ArrowRight size={16} aria-hidden="true" />
                </span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { initProjectsPortfolio } from "../../scripts/animations/projects-portfolio";
  initProjectsPortfolio();
</script>
