---
import { ArrowRight, ChevronDown } from "@lucide/astro";
import { faqs } from "../../data/faqs";
---

<section
  id="faq"
  class="mx-[clamp(12px,1vw,18px)] my-5 overflow-hidden rounded-[32px] bg-[#1b1b1b] py-16 text-white md:py-20 lg:py-24"
  aria-labelledby="faq-heading"
>
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl items-start gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-16">
      <div>
        <!-- <span class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-medium tracking-wide uppercase text-white">
          <span
            class="size-1 rounded-full bg-[#f0c653]"
            aria-hidden="true"
          ></span>
          FAQs
        </span> -->
        <h2
          id="faq-heading"
          class="mt-4 text-[clamp(2.25rem,3.4vw,3.25rem)] leading-[1.08] font-semibold tracking-tight"
        >
          <span class="block">Answers Most</span>
          <span class="block">
            Common <span class="text-[#f0c653]">Queries!</span>
          </span>
        </h2>

        <div class="mt-9 w-full max-w-[260px] rounded-[22px] bg-[#f0c653] p-5 text-[#203b3b] sm:p-6">
          <p class="text-lg leading-snug font-semibold">
            Have Any Question
            <br />
            on Your Minds?
          </p>
          <a
            href="tel:+94774166098"
            class="mt-4 inline-flex min-h-[50px] items-center gap-3 rounded-full bg-[#000000] py-1 pr-[5px] pl-6 text-sm font-semibold text-[#ffffff] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#e6b83b] focus-visible:outline-2 focus-visible:outline-white focus-visible:outline-offset-2"
          >
            Get In Touch
            <span class="grid size-10 place-items-center rounded-full bg-[#000000]">
              <ArrowRight size={19} strokeWidth={1.7} aria-hidden="true" />
            </span>
          </a>
        </div>
      </div>

      <div class="space-y-3" aria-label="Frequently asked questions">
        {faqs.map((faq, index) => (
          <article
            class="group rounded-[16px] border border-white/15 bg-transparent text-white transition-colors duration-300 data-[active=true]:border-[#f0c653] data-[active=true]:bg-[#f0c653] data-[active=true]:text-[#203b3b]"
            data-faq-item
            data-faq-index={index}
            data-active={index === 0 ? "true" : "false"}
          >
            <h3>
              <button
                type="button"
                class="flex min-h-[60px] w-full cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left text-sm font-semibold outline-offset-2 focus-visible:rounded-[16px] focus-visible:outline-2 focus-visible:outline-[#f0c653] sm:px-6 sm:text-base"
                data-faq-trigger
                aria-expanded={index === 0 ? "true" : "false"}
                aria-controls={`faq-panel-${faq.id}`}
              >
                <span>{faq.question}</span>
                <span
                  class="grid size-7 shrink-0 place-items-center rounded-full bg-white/10 text-white transition-colors duration-300 group-data-[active=true]:bg-[#203b3b]"
                  aria-hidden="true"
                >
                  <ChevronDown
                    size={15}
                    class="transition-transform duration-300 group-data-[active=true]:rotate-180"
                  />
                </span>
              </button>
            </h3>
            <div
              id={`faq-panel-${faq.id}`}
              class:list={[
                "overflow-hidden",
                index === 0 ? "h-auto opacity-100" : "h-0 opacity-0",
              ]}
              data-faq-panel
              aria-hidden={index === 0 ? "false" : "true"}
              inert={index !== 0}
            >
              <p class="px-5 pb-5 text-sm leading-6 text-[#324443] sm:px-6">
                {faq.answer}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { initFaq } from "../../scripts/animations/faq";
  initFaq();
</script>
