---
import { Image } from "astro:assets";
import { ArrowRight, Check } from "@lucide/astro";
import mainImage from "../../assets/who-we-are.jpg";
import secondImage from "../../assets/who-we-are-2.jpg";
import trolleyImage from "../../assets/move.png";

const benefits = [
  "Certainty that the move will actually happen as planned",
  "Professional management of complex logistics",
  "Showing up on time, careful handling no hidden fees",
];
---

<section
  id="who-we-are"
  class="relative overflow-hidden bg-white py-20 md:py-24 lg:py-28"
  aria-labelledby="who-we-are-heading"
>
  <div class="relative z-1 mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 xl:gap-16">
      <div class="grid min-w-0 grid-cols-2 grid-rows-[17rem_11rem] gap-3 sm:grid-cols-[1.15fr_0.95fr] sm:grid-rows-[12rem_23.5rem] sm:gap-5 lg:grid-rows-[11rem_21rem] xl:grid-rows-[12rem_23.5rem]">
        <div class="col-span-2 overflow-hidden rounded-3xl bg-[#e9e4de] sm:col-span-1 sm:row-span-2">
          <Image
            src={mainImage}
            alt="Movers loading boxes into a truck"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <div class="flex flex-col justify-center rounded-3xl bg-[#f0c653] px-5 py-5 text-[#203b3b] sm:px-8 lg:px-6 xl:px-8">
          <strong class="text-[clamp(2.1rem,3.2vw,3.25rem)] leading-none font-medium tracking-[-0.05em]">
            25k
          </strong>
          <p class="mt-3 max-w-[12rem] text-sm leading-snug font-semibold sm:mt-5 sm:text-lg">
            Years of Working Experience
          </p>
        </div>
        <div class="overflow-hidden rounded-3xl bg-[#e9e4de]">
          <Image
            src={secondImage}
            alt="People carrying moving boxes indoors"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <div class="min-w-0 lg:py-6">
        <h2
          id="who-we-are-heading"
          class="text-[clamp(2.25rem,3.3vw,3.7rem)] leading-[1.1] font-semibold tracking-[-0.045em] text-[#203b3b]"
        >
          Best Citywide Moving Services{" "}
          <span data-trust-text class="inline-block text-[#f0c653]">
            You Can Trust.
          </span>
        </h2>
        <p class="mt-6 max-w-2xl text-base leading-7 text-[#858b8d]">
          The moving industry thrives on trust and reputation. Your visual
          identity and marketing should scream professional reliable, and caring
          at every touchpoint. In an industry where anxiety Your visual identity
          and marketing
        </p>
        <ul class="mt-8 space-y-4">
          {benefits.map((benefit) => (
            <li class="flex items-start gap-3 text-[15px] leading-6 text-[#202627] sm:text-base">
              <span class="mt-1 grid size-[19px] shrink-0 place-items-center rounded-full bg-[#f0c653] text-white">
                <Check size={13} strokeWidth={3} aria-hidden="true" />
              </span>
              <span>{benefit}</span>
            </li>
          ))}
        </ul>
        <div class="mt-10 flex flex-wrap items-center gap-5 sm:gap-6">
          <a
            class="inline-flex min-h-[50px] items-center gap-3 rounded-full bg-[#f0c653] py-1 pr-[5px] pl-6 text-sm font-semibold text-[#263735] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#e6b83b] focus-visible:outline-2 focus-visible:outline-[#a07825] focus-visible:outline-offset-[3px]"
            href="#who-we-are"
          >
            More About Us
            <span class="grid size-10 place-items-center rounded-full bg-[#fffdf8]">
              <ArrowRight size={19} strokeWidth={1.7} aria-hidden="true" />
            </span>
          </a>
          <div class="flex items-center gap-3">
            <span class="size-12 overflow-hidden rounded-full ring-2 ring-[#f0c653] ring-offset-2">
              <Image
                src={secondImage}
                alt=""
                class="h-full w-full object-cover object-right"
                loading="lazy"
              />
            </span>
            <span class="flex flex-col">
              <span class="font-semibold text-[#203b3b]">Mahima Induvara</span>
              <span class="text-sm text-[#858b8d]">Founder</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <Image
    src={trolleyImage}
    alt=""
    aria-hidden="true"
    data-moving-trolley
    class="pointer-events-none absolute right-[1rem] bottom-0 hidden w-48 select-none xl:block 2xl:w-72"
    loading="lazy"
  />
</section>

<script>
  import { initWhoWeAre } from "../../scripts/animations/who-we-are";
  initWhoWeAre();
</script>
