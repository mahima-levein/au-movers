---
import { ArrowRight } from "@lucide/astro";
import { Image } from "astro:assets";
import truckImage from "../../assets/truck.png";
import HeroGallery from "./HeroGallery.astro";
import TextMarquee from "../ui/TextMarquee.astro";
---

<section
  id="home-hero"
  class="relative mx-[clamp(12px,1vw,18px)] mt-3 h-dvh min-h-[620px] overflow-hidden rounded-t-[28px] bg-[#faf6f2] text-brand-ink max-[620px]:h-auto max-[620px]:min-h-0"
  aria-labelledby="hero-heading"
>
  <div class="relative size-full max-[620px]:h-auto">
    <div class="absolute top-[55%] left-[max(6vw,calc((100vw-1536px)/2))] z-2 w-[min(760px,55vw)] -translate-y-1/2 max-[1250px]:left-[6vw] max-[1250px]:w-[58vw] max-[850px]:top-[40%] max-[850px]:w-[75vw] max-[620px]:relative max-[620px]:top-auto max-[620px]:left-auto max-[620px]:flex max-[620px]:min-h-[min(650px,90svh)] max-[620px]:w-full max-[620px]:translate-y-0 max-[620px]:flex-col max-[620px]:justify-center max-[620px]:px-5 max-[620px]:pt-32 max-[620px]:pb-10">
      <div class="max-[620px]:relative max-[620px]:flex max-[620px]:flex-col max-[620px]:items-center">
        <h1
          id="hero-heading"
          class="relative z-2 text-[clamp(48px,4.5vw,78px)] leading-[1.05] font-semibold tracking-[-0.05em] max-[850px]:text-[clamp(42px,5vw,60px)] max-[620px]:text-center max-[620px]:text-[clamp(23px,6.4vw,38px)] max-[620px]:leading-[1.15] max-[620px]:tracking-[-0.035em]"
        >
          <span class="block font-extrabold">Found a Lower Price?</span>
          <span class="mt-3 block text-brand-gold">We'll Match It!</span>
        </h1>
        <div
          class="relative mt-7 w-full min-w-0 max-w-[420px] min-[621px]:hidden"
          aria-hidden="true"
        >
          <span class="absolute inset-x-0 top-10 mx-auto h-44 w-52 rounded-full bg-brand-gold/8 [mask-image:radial-gradient(ellipse,black,transparent_70%)]"></span>
          <div data-hero-truck class="relative mx-auto w-full pt-1">
            <Image
              src={truckImage}
              alt="ANP Movers branded moving truck"
              widths={[400, 600, 800]}
              sizes="(max-width: 620px) min(420px, 85vw), 1px"
              format="webp"
              loading="eager"
              class="block h-auto w-full drop-shadow-[0_12px_8px_rgb(20_42_81_/_10%)]"
            />
          </div>
        </div>
      </div>
      <p class="mt-7 max-w-[540px] text-base leading-7 text-brand-ink/65 max-[620px]:hidden">
        Tell us about your move and explore a packing plan that suits your needs
        and budget. Found a lower price? We’ll match it, with no hidden fees.
      </p>
      <p
        data-hero-fees
        class="mt-3 text-xl font-semibold tracking-tight max-[620px]:mt-5 max-[620px]:text-center max-[620px]:text-lg"
      >
        No Hidden Fees!
      </p>
      <div class="mt-7 flex max-[620px]:mt-5 max-[620px]:justify-center">
        <a
          href="#pricing"
          class="group inline-flex min-h-12 items-center gap-5 rounded-full bg-brand-gold py-1.5 pr-1.5 pl-6 text-sm font-semibold text-brand-ink shadow-sm transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-brand-ink focus-visible:outline-offset-4 motion-reduce:transform-none"
        >
          View Moving Plans
          <span class="grid size-9 place-items-center rounded-full bg-white">
            <ArrowRight
              size={20}
              strokeWidth={1.8}
              class="transition-transform group-hover:translate-x-0.5 motion-reduce:transform-none"
              aria-hidden="true"
            />
          </span>
        </a>
      </div>
    </div>
    <HeroGallery />
    <div class="relative z-2 px-4 pb-8 min-[621px]:hidden">
      <div id="hero-quote-slot" class="min-h-[440px] scroll-mt-28"></div>
      <noscript>
        <p class="mt-4 text-center text-sm">
          Please enable JavaScript to use the moving quote form, or{" "}
          <a href="tel:+94774166098" class="underline">
            call our team
          </a>
          .
        </p>
      </noscript>
    </div>
  </div>
</section>
<TextMarquee />

<script>
  import { initHeroTruck } from "../../scripts/animations/hero-truck";
  initHeroTruck();
</script>
