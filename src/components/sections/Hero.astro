---
import { ArrowRight, Play } from "@lucide/astro";
import { Image } from "astro:assets";
import image6 from "../../assets/vertical-g6.jpg";
import HeroGallery from "./HeroGallery.astro";
import TextMarquee from "../../components/ui/TextMarquee.astro";
---

<section
  id="home-hero"
  class="relative mx-[clamp(12px,1vw,18px)] mt-3 h-dvh overflow-hidden rounded-t-[28px] bg-[#faf6f2] text-[#203b3b]"
  aria-labelledby="hero-heading"
>
  <div class="relative size-full">
    <div class="absolute top-[55%] left-[max(6vw,calc((100vw-1536px)/2))] z-2 w-[min(760px,55vw)] -translate-y-1/2 max-[1250px]:left-[6vw] max-[1250px]:w-[58vw] max-[850px]:top-[40%] max-[850px]:w-[75vw] max-[620px]:top-[37%] max-[620px]:w-[88vw]">
      <h1
        id="hero-heading"
        class="m-0 text-[clamp(56px,5vw,88px)] leading-[0.99] font-bold tracking-[-0.065em] max-[1250px]:text-[clamp(48px,5.1vw,70px)] max-[850px]:text-[clamp(46px,6.5vw,66px)] max-[620px]:text-[clamp(34px,8vw,51px)]"
      >
        <span class="block whitespace-nowrap max-[620px]:whitespace-normal">
          Moving your life
        </span>
        <span class="block whitespace-nowrap max-[620px]:whitespace-normal">
          with care precision
        </span>
        <span class="flex items-center gap-[0.18em] whitespace-nowrap max-[620px]:whitespace-normal">
          <span>and</span>
          <span class="inline-block h-[0.65em] w-[1.75em] flex-none translate-y-[0.04em] overflow-hidden rounded-full">
            <Image
              src={image6}
              alt=""
              class="size-full object-cover object-[center_58%]"
            />
          </span>
          <span>trust</span>
        </span>
      </h1>
      <p class="mt-[30px] max-w-[560px] text-[clamp(13px,1vw,16px)] leading-[1.75] text-[#858b8d] max-[850px]:max-w-[490px] max-[620px]:mt-5 max-[620px]:text-xs max-[620px]:leading-[1.6]">
        Creating a compelling brand identity and marketing strategy for a moving
        company requires balancing trust reliability and professionalism.
      </p>
      <div class="mt-[30px] flex flex-wrap items-center gap-[18px] max-[620px]:mt-5 max-[620px]:gap-3">
        <button
          type="button"
          data-open-quote
          class="inline-flex min-h-11 items-center gap-[13px] rounded-full bg-[#f0c653] py-1 pr-[5px] pl-5 text-[13px] font-semibold text-[#263735] transition-all duration-200 hover:-translate-y-0.5 hover:bg-[#e6b83b] focus-visible:outline-2 focus-visible:outline-[#a07825] focus-visible:outline-offset-[3px] max-[620px]:min-h-10 max-[620px]:pl-3.5 max-[620px]:text-[11px]"
        >
          Discover Services{" "}
          <span class="grid size-[34px] place-items-center rounded-full bg-[#fffdf8] max-[620px]:size-[30px]">
            <ArrowRight size={18} strokeWidth={1.7} aria-hidden="true" />
          </span>
        </button>
        <button
          class="inline-flex cursor-not-allowed items-center gap-[15px] border-0 bg-transparent p-0 text-[13px] font-semibold text-[#344d4e] max-[620px]:gap-2 max-[620px]:text-[11px]"
          type="button"
          disabled
          title="Video coming soon"
        >
          <span class="grid size-11 place-items-center rounded-full bg-[#e9e5e1] max-[620px]:size-[38px]">
            <Play
              size={16}
              fill="currentColor"
              strokeWidth={1.3}
              aria-hidden="true"
            />
          </span>
          <span>Watch Video</span>
        </button>
      </div>
    </div>
    <HeroGallery />
  </div>
</section>
<TextMarquee />
