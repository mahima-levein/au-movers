---
import { ArrowRight, Check } from "@lucide/astro";
import { pricingPlans } from "../../data/pricing-plans";
---

<section
  id="pricing"
  class="bg-white py-20 md:py-24 lg:py-28"
  aria-labelledby="pricing-heading"
>
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h2
        id="pricing-heading"
        class="mx-auto max-w-4xl text-center text-[clamp(2.35rem,4vw,3.75rem)] leading-[1.1] font-semibold tracking-tight text-brand-ink"
      >
        <span class="block">Choose the Right Plan</span>
        <span class="block">
          <span class="text-brand-gold">for You</span>
        </span>
      </h2>

      <div
        class="mx-auto mt-10 grid w-full max-w-3xl grid-cols-1 gap-1 sm:grid-cols-3 rounded-2xl bg-[#f6f1ec] p-1.5 sm:rounded-full"
        role="tablist"
        aria-label="Moving and packing plans"
      >
        {pricingPlans.map((plan, index) => (
          <button
            id={`tab-${plan.id}`}
            type="button"
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls={`panel-${plan.id}`}
            tabindex={index === 0 ? 0 : -1}
            data-packing-tab
            class="min-h-12 flex-1 cursor-pointer rounded-xl px-4 py-3 text-sm font-semibold text-brand-ink transition-colors hover:bg-brand-ink/10 focus-visible:outline-2 focus-visible:outline-brand-ink focus-visible:outline-offset-2 aria-selected:bg-brand-ink aria-selected:text-white sm:rounded-full sm:px-6"
          >
            {plan.name}
          </button>
        ))}
      </div>

      <div class="mx-auto mt-6 max-w-[600px]">
        {pricingPlans.map((plan, index) => (
          <article
            id={`panel-${plan.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${plan.id}`}
            tabindex="0"
            hidden={index !== 0}
            data-packing-panel
            class:list={[
              "group flex min-w-0 flex-col overflow-hidden rounded-[22px] p-6 text-[#203b3b] transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-brand-ink focus-visible:outline-offset-4 motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-8 lg:p-9 [&[hidden]]:hidden",
              plan.featured ? "bg-[#e8c45c]" : "bg-[#f6f1ec]",
            ]}
          >
            <div class="flex min-h-[66px] flex-wrap items-start justify-between gap-3">
              <div>
                <h3
                  id={`plan-${plan.id}`}
                  class="text-brand-ink text-xl font-semibold"
                >
                  {plan.name}
                </h3>
                <p class="mt-1 text-sm text-[#687274]">{plan.subtitle}</p>
              </div>
              {plan.badge && (
                <span class="shrink-0 rounded-full bg-[#203b3b] px-4 py-2 text-xs font-semibold text-white">
                  {plan.badge}
                </span>
              )}
            </div>

            <p class="mt-5 flex items-end gap-1">
              <span class="text-[clamp(2.7rem,4vw,3.5rem)] leading-none font-medium tracking-tight">
                {plan.price}
              </span>
              <span class="pb-1 text-sm text-[#4f6262]">{plan.suffix}</span>
            </p>

            <ul class="mt-10 grid grid-cols-1 gap-x-5 gap-y-3 text-[13px] sm:grid-cols-2">
              {plan.features.map((feature) => (
                <li
                  class:list={[
                    "flex min-w-0 items-start gap-2 leading-5 font-medium",
                    !feature.available && "opacity-40",
                  ]}
                >
                  <span
                    class="mt-0.5 grid size-4 shrink-0 place-items-center rounded-full bg-white text-[#203b3b]"
                    aria-hidden="true"
                  >
                    <Check size={11} strokeWidth={3} />
                  </span>
                  <span>{feature.label}</span>
                  {!feature.available && (
                    <span class="sr-only"> (not included)</span>
                  )}
                </li>
              ))}
            </ul>

            <a
              href={plan.href}
              aria-label={`${plan.ctaLabel}: ${plan.name}. Call ANP Movers`}
              class:list={[
                "group/cta mt-9 flex min-h-[48px] w-full items-center justify-between gap-3 rounded-full py-1 pr-1 pl-5 text-sm font-semibold uppercase transition-transform duration-300 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-[#203b3b] focus-visible:outline-offset-2",
                plan.featured
                  ? "bg-[#142A51] text-white"
                  : "bg-white text-[#203b3b]",
              ]}
            >
              <span>{plan.ctaLabel}</span>
              <span
                class:list={[
                  "grid size-10 shrink-0 place-items-center rounded-full",
                  plan.featured
                    ? "bg-white text-[#203b3b]"
                    : "bg-[#142A51] text-white",
                ]}
              >
                <ArrowRight
                  size={18}
                  class="transition-transform duration-300 group-hover/cta:translate-x-0.5"
                  aria-hidden="true"
                />
              </span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector("#pricing");
  const tabs = [
    ...(section?.querySelectorAll<HTMLButtonElement>("[data-packing-tab]") ??
      []),
  ];
  const panels = [
    ...(section?.querySelectorAll<HTMLElement>("[data-packing-panel]") ?? []),
  ];

  function selectTab(index: number) {
    tabs.forEach((tab, tabIndex) => {
      const active = tabIndex === index;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
      panels[tabIndex].hidden = !active;
    });
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectTab(index));
    tab.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft")
        next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      selectTab(next);
      tabs[next].focus();
    });
  });
</script>
