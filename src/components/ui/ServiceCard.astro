---
import { Image } from "astro:assets";
import {
  ListChecks,
  HardHat,
  PackageCheck,
  ClipboardCheck,
  MessagesSquare,
  HandHeart,
  Phone,
  ArrowRight,
} from "@lucide/astro";
import type { ServiceItem } from "../../data/services";
interface Props {
  service: ServiceItem;
}
const { service } = Astro.props;
const iconMap = {
  preparation: ListChecks,
  safety: HardHat,
  packing: PackageCheck,
  planning: ClipboardCheck,
  communication: MessagesSquare,
  care: HandHeart,
};
const Icon = iconMap[service.icon];
const buttonClass =
  "inline-flex min-h-11 items-center justify-between gap-2 rounded-full py-1 pr-1 pl-4 text-xs font-semibold text-black transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-brand-gold focus-visible:outline-offset-4 motion-reduce:transform-none sm:text-sm";
---

<article
  class="group relative h-[600px] w-[85vw] shrink-0 snap-start overflow-hidden rounded-3xl bg-brand-ink sm:w-[340px] md:w-[370px] xl:w-[380px]"
  data-service-card
>
  <Image
    src={service.image}
    alt=""
    data-service-image
    class="h-full w-full object-cover"
    loading="lazy"
  />
  <div class="absolute inset-x-2 bottom-2 flex flex-col rounded-2xl border border-white/10 bg-brand-ink p-5 transition-[border-color,box-shadow] duration-300 group-hover:border-brand-gold group-hover:shadow-[0_8px_24px_rgb(0_0_0_/_20%)] group-focus-within:border-brand-gold sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <span class="text-brand-gold">
        <Icon size={40} strokeWidth={1.5} aria-hidden="true" />
      </span>
      <span
        class="text-5xl leading-none font-semibold tracking-tight text-white/25"
        aria-hidden="true"
      >
        {service.number}
      </span>
    </div>
    <h3 class="mt-5 text-xl font-semibold tracking-tight text-brand-gold">
      {service.title}
    </h3>
    <p class="mt-2 text-sm leading-6 text-[#b9c8c7]">{service.description}</p>
    <div class="mt-auto grid grid-rows-[1fr] opacity-100 transition-[grid-template-rows,opacity,transform] duration-400 ease-out motion-reduce:transition-none [@media(min-width:1024px)_and_(hover:hover)_and_(pointer:fine)]:pointer-events-none [@media(min-width:1024px)_and_(hover:hover)_and_(pointer:fine)]:translate-y-3 [@media(min-width:1024px)_and_(hover:hover)_and_(pointer:fine)]:grid-rows-[0fr] [@media(min-width:1024px)_and_(hover:hover)_and_(pointer:fine)]:opacity-0 group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:grid-rows-[1fr] group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:grid-rows-[1fr] group-focus-within:opacity-100">
      <div class="min-h-0 lg:overflow-hidden">
        <div class="grid grid-cols-2 gap-2 pt-5 lg:px-1 lg:pb-1">
          <a
            href="tel:+94774166098"
            class:list={[buttonClass, "bg-brand-gold hover:bg-[#ddb24b]"]}
            aria-label={`Call ANP Movers about ${service.title}`}
          >
            Call Now{" "}
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-white">
              <Phone size={15} aria-hidden="true" />
            </span>
          </a>
          <a
            href="#request-quote"
            class:list={[buttonClass, "bg-white hover:bg-[#f5f0e5]"]}
          >
            Get in Touch{" "}
            <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brand-gold">
              <ArrowRight size={16} aria-hidden="true" />
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
