---
import whatsappIcon from "../../assets/whatsapp.svg?url";

const message =
  "Hi ANP Movers! I'm planning a move and would like a quote. Could you help me with availability and pricing?";
const whatsappUrl = `https://wa.me/94774166098?text=${encodeURIComponent(message)}`;
---

<a
  id="floating-call"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with ANP Movers on WhatsApp (opens in a new tab)"
  class="group fixed bottom-[max(20px,env(safe-area-inset-bottom))] right-[max(20px,env(safe-area-inset-right))] z-20 grid size-14 place-items-center rounded-full bg-[#25D366] text-white shadow-lg ring-1 ring-white/30 transition-[transform,background-color] duration-200 hover:scale-110 hover:bg-[#1ebe5d] focus-visible:outline-2 focus-visible:outline-[#25D366] focus-visible:outline-offset-4 motion-reduce:transform-none sm:size-16"
>
  <span
    class="pointer-events-none absolute inset-0 rounded-full border border-[#25D366]/40 motion-safe:animate-ping group-hover:animate-none group-focus-visible:animate-none"
    aria-hidden="true"
  ></span>
  <img
    src={whatsappIcon}
    alt=""
    width="32"
    height="32"
    class="size-8 object-contain"
  />
</a>
