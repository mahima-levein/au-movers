---
import { Phone } from "@lucide/astro";
---

<a
  id="floating-call"
  href="tel:+94774166098"
  aria-label="Call ANP Movers on +94 77 416 6098"
  class="group fixed bottom-[max(20px,env(safe-area-inset-bottom))] right-[max(20px,env(safe-area-inset-right))] z-20 grid size-14 place-items-center rounded-full bg-brand-ink text-brand-gold shadow-lg ring-1 ring-brand-gold/30 transition-transform duration-200 hover:scale-110 focus-visible:outline-2 focus-visible:outline-brand-gold focus-visible:outline-offset-4 motion-reduce:transform-none sm:size-16"
>
  <span
    class="pointer-events-none absolute inset-0 rounded-full border border-brand-gold/50 motion-safe:animate-ping group-hover:animate-none group-focus-visible:animate-none"
    aria-hidden="true"
  ></span>
  <Phone size={25} strokeWidth={1.8} aria-hidden="true" />
</a>
