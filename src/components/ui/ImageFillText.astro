---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id?: string;
  text?: string;
  image: string | ImageMetadata;
  class?: string;
}

const {
  id = "image-fill-text",
  text = "ANP MOVERs",
  image,
  class: className = "",
} = Astro.props;
const imageUrl =
  typeof image === "string"
    ? image
    : (await getImage({ src: image, format: "webp", width: 1200 })).src;
---

<section id={id} class:list={["bg-white py-16 md:py-20 lg:py-24", className]}>
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <h2
      class="mx-auto bg-cover bg-clip-text bg-[position:center_var(--image-y,50%)] bg-no-repeat text-center text-[clamp(2.25rem,6.2vw,10rem)] leading-none font-black tracking-[-0.05em] text-[#0b3434] uppercase sm:whitespace-nowrap supports-[(-webkit-background-clip:text)]:[background-image:var(--fill-image)] supports-[(-webkit-background-clip:text)]:text-transparent supports-[(-webkit-background-clip:text)]:[-webkit-text-fill-color:transparent]"
      style={`--fill-image: url('${imageUrl}')`}
      data-image-fill-text
    >
      {text}
    </h2>
  </div>
</section>

<script>
  import { initImageFillText } from "../../scripts/animations/image-fill-text";
  initImageFillText();
</script>
